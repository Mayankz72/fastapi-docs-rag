GEMINI_API_KEY=
# Optional; falls back to GEMINI_API_KEY if unset.
GEMINI_API_KEY_EMBED=
GITHUB_TOKEN=
QDRANT_URL=http://localhost:6333
# Only needed for Qdrant Cloud.
QDRANT_API_KEY=
QDRANT_COLLECTION=fastapi_corpus
QDRANT_COLLECTION_LOCAL=fastapi_corpus_local
# gemini or local
EMBED_BACKEND=gemini
# Optional cross-encoder reranking stage.
USE_RERANKER=false
RERANK_FETCH_K=20

# Only needed for src/index/migrate_to_cloud.py
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=
